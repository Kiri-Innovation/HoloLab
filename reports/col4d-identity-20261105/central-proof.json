              "normalized": {
                "apiVersion": "hololab.dev/v1",
                "category": "reconstruction/colmap4d",
                "description": "Materialize XMP-timestamped rig images on colmap4d's fixed time grid and emit a rig_timeline visualization bundle from the same grouping result.\n",
                "docs": "Reads ``arrayed[cam,index]<image>`` and emits both\n``arrayed[group,cam]<image,colmap4d-temporal-groups>`` and the legacy-compatible\n``rig_timeline`` PNG/HTML/report bundle. Grouping uses the public\n``colmap4d.group_by_grid`` API from colmap4d 1.0.2 or newer.\n",
                "exec": {
                  "shell": "set -euo pipefail\nTRIM=()\nif [ \"{{ params.trim_edges | lower }}\" = \"true\" ]; then\n  TRIM=(--trim-edges)\nfi\npython \"{{ pack_dir }}/group_temporal_images.py\" \\\n  --frames \"{{ inputs.frames }}\" \\\n  --output \"{{ outputs.groups }}\" \\\n  --timeline-output \"{{ outputs.exposure_timeline }}\" \\\n  --grid-ns {{ params.grid_ns }} \\\n  --n-cams {{ params.n_cams }} \\\n  \"${TRIM[@]}\"\ntest -s \"{{ outputs.exposure_timeline }}/exposure_timeline_full.png\"\ntest -s \"{{ outputs.exposure_timeline }}/exposure_timeline_zoom.html\"\n"
                },
                "idempotency": {
                  "marker": "{{ outputs.groups }}/.hololab-done"
                },
                "inputs": {
                  "frames": {
                    "arrayed": true,
                    "description": "ClockSync server-epoch JPEG tree with per-image rig XMP.",
                    "dim_labels": [
                      "cam",
                      "index"
                    ],
                    "storage": "dir",
                    "tags": [
                      "image"
                    ]
                  }
                },
                "kind": "Algorithm",
                "name": "col4d/colmap4d-temporal-grouping",
                "outputs": {
                  "exposure_timeline": {
                    "arrayed": false,
                    "description": "Legacy-compatible exposure_timeline PNG/HTML/report bundle.",
                    "storage": "dir",
                    "tags": [
                      "rig_timeline"
                    ]
                  },
                  "groups": {
                    "arrayed": true,
                    "description": "Materialized group/camera JPEG array with hidden grouping provenance.",
                    "dim_labels": [
                      "group",
                      "cam"
                    ],
                    "storage": "dir",
                    "tags": [
                      "image",
                      "colmap4d-temporal-groups"
                    ]
                  }
                },
                "params": {
                  "grid_ns": {
                    "default": 33333333,
                    "description": "Fixed-grid bucket width in nanoseconds.",
                    "min": 1,
                    "type": "int"
                  },
                  "n_cams": {
                    "default": 0,
                    "description": "Expected devices for complete buckets; 0 infers all XMP aliases.",
                    "min": 0,
                    "type": "int"
                  },
                  "trim_edges": {
                    "default": true,
                    "description": "Keep the inclusive first-to-last complete span, including interior gaps.",
                    "type": "bool"
                  }
                },
                "progress": {
                  "stdout_regex": "\\[ITER (\\d+)/(\\d+)\\]"
                },
                "requires": {
                  "packages": [
                    "colmap4d",
                    "matplotlib",
                    "plotly"
                  ]
