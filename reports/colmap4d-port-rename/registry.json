              "normalized": {
                "apiVersion": "hololab.dev/v1",
                "category": "reconstruction/colmap4d",
                "description": "Assemble grouped points/cams and flat images into one flat-layout colmap4d model.",
                "docs": "The image input is strictly one-dimensional. Convert the upstream\n`arrayed[group,cam]<image>` with the type-agnostic `flatten-array@0.1.0`.\nRoot-level elements use the generic `<outer>__<inner>` convention\n(`gXXXXXX__camN.jpg` here).\n\nThe input element name is preserved as both COLMAP `Image.name` and the\nroot-level path below `images/`. Grouping remains recoverable from the name\nfor assembly alignment, without becoming an output directory hierarchy.\n",
                "exec": {
                  "shell": "set -euo pipefail\npython \"{{ pack_dir }}/merge_colmap4d.py\" \\\n  --points \"{{ inputs.points }}\" \\\n  --images \"{{ inputs.images }}\" \\\n  --cams \"{{ inputs.cams }}\" \\\n  --output \"{{ outputs.model }}\"\n"
                },
                "idempotency": {
                  "marker": "{{ outputs.model }}/.hololab-done"
                },
                "inputs": {
                  "cams": {
                    "arrayed": true,
                    "dim_labels": [
                      "group"
                    ],
                    "require_axis_label_match": false,
                    "storage": "dir",
                    "tags": [
                      "colmap-cams"
                    ]
                  },
                  "images": {
                    "arrayed": true,
                    "storage": "dir",
                    "tags": [
                      "image"
                    ]
                  },
                  "points": {
                    "arrayed": true,
                    "dim_labels": [
                      "group"
                    ],
                    "require_axis_label_match": false,
                    "storage": "dir",
                    "tags": [
                      "point-cloud"
                    ]
                  }
                },
                "kind": "Algorithm",
                "name": "col4d/merge-colmap4d",
                "outputs": {
                  "model": {
                    "arrayed": false,
                    "storage": "dir",
                    "tags": [
                      "colmap4d"
                    ]
                  }
                },
                "progress": {
                  "stdout_regex": "\\[ITER (\\d+)/(\\d+)\\]"
                },
