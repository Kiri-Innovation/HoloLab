      "normalized": {
        "apiVersion": "hololab.dev/v1",
        "category": "reconstruction/colmap4d",
        "description": "Assemble colmap4d components with array validation and byte-preserving binary copies; optional full strict validation.",
        "docs": "Uses colmap4d.arrays.read_point_arrays and read_image_headers. No Python Point3D/observation objects on the canonical uniform-track binary fast path. Binary files and pixels are independently copied unchanged; IDs, observations and int64 ns are preserved. Default fast validation is not a validate_full certification: single-track reciprocity is exhaustive; multi-track reciprocity/centroids sample up to 4096 points and observations per image. All records receive structure, geometry, ID, time-coverage and bounds checks. strict_validate=true and text/nonuniform-layout fallbacks retain the legacy complete validator and final validate_full(strict). No library modifications, XMP inference, timestamp changes or hardlinks. See README.md for coverage and performance evidence.",
        "exec": {
          "shell": "set -euo pipefail\npython -u \"{{ pack_dir }}/merge_colmap4d.py\" --points \"{{ inputs['4d_points'] }}\" --cams \"{{ inputs['4d_cams'] }}\" --images \"{{ inputs['4d_images'] }}\" --output \"{{ outputs.colmap4d }}\" {% if params.strict_validate %}--strict-validate{% endif %}\n"
        },
        "idempotency": {
          "marker": "{{ outputs.colmap4d }}/.hololab-done"
        },
        "inputs": {
          "4d_cams": {
            "arrayed": false,
            "storage": "dir",
            "tags": [
              "colmap4d-cams"
            ]
          },
          "4d_images": {
            "arrayed": false,
            "storage": "dir",
            "tags": [
              "colmap4d-images"
            ]
          },
          "4d_points": {
            "arrayed": false,
            "storage": "dir",
            "tags": [
              "colmap4d-point-cloud"
            ]
          }
        },
        "kind": "Algorithm",
        "name": "col4d/merge-colmap4d",
        "outputs": {
          "colmap4d": {
            "arrayed": false,
            "storage": "dir",
            "tags": [
              "colmap4d"
            ]
          }
        },
        "params": {
          "strict_validate": {
            "default": false,
            "description": "Default false: validate binary structure, full ID/time coverage, geometry, pixels and track bounds with arrays. Single-observation points receive exhaustive reciprocal/time checks; multi-observation relations and centroids are sampled. Enable for untrusted/external data to run full legacy reciprocal checks and final validate_full(strict). Text/nonuniform layouts automatically use full validation.",
            "type": "bool"
          }
        },
