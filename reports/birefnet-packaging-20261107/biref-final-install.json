            "shell": "python \"{{ pack_dir }}/run.py\" --video \"{{ inputs.video }}\" --output \"{{ outputs.masks }}\" --scratch \"{{ scratch_dir }}\" --max-frames \"{{ params.max_frames }}\" --skip \"{{ params.skip }}\" --start-frame \"{{ params.start_frame }}\" --end-frame \"{{ params.end_frame }}\" --max-width \"{{ params.max_width }}\" --checkpoint \"{{ params.checkpoint or \"\" }}\" --batch-size \"{{ params.batch_size }}\""
