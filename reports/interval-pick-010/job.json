      "normalized": {
        "apiVersion": "hololab.dev/v1",
        "category": "basic/array/interval-pick",
        "description": "Pick every Nth element by zero-based index along an array's outer axis.",
        "docs": "Select positions start, start+interval, ... from visible outer entries ordered by basename bytes. No timestamps, FPS, frame-name parsing or content decoding. Tags and all axis names are inherited; inner arrays are untouched. Preserves selected entry names and links to resolved source elements, like slice. Output is a real directory, not an array view. Sources must remain available. Empty input or start >= N yields an empty output. Output must be empty and must not overlap input. Uses only the Python standard library in the node host runtime.",
        "exec": {
          "args": [
            "--input",
            "{{ inputs.in }}",
            "--output",
            "{{ outputs.out }}",
            "--interval",
            "{{ params.interval }}",
            "--start",
            "{{ params.start }}"
          ],
          "python": "interval_pick.py"
        },
        "inputs": {
          "in": {
            "arrayed": true,
            "description": "A materialized array directory of any element type; selects the outer axis.",
            "tags": [
              "any"
            ]
          }
        },
        "kind": "Algorithm",
        "name": "builtin/interval-pick",
        "outputs": {
          "out": {
            "arrayed": true,
            "dim_labels_drop_outer": 0,
            "dim_labels_from_input": "in",
            "tags": [
              "any"
            ],
            "tags_from": "in"
          }
        },
        "params": {
          "interval": {
            "default": 2,
            "description": "Index stride, not time. 2 selects indexes 0, 2, 4, ... when start is 0.",
            "min": 1,
            "type": "int"
          },
          "start": {
            "default": 0,
            "description": "Zero-based starting index. A start beyond the array produces an empty array.",
            "min": 0,
            "type": "int"
          }
        },
        "requires": {},
        "runtime": {
          "gpu": {
            "required": false
          },
          "mode": "host"
        }
