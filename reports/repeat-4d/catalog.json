      "tags": [
        "colmap-camera"
      ],
      "required": true,
      "inline": null,
      "inline_default": null,
      "require_axis_label_match": true,
      "storage": "file",
      "description": null,
      "arrayed": false,
      "scalar": false,
      "dim_labels": [],
      "content_dims_from": null,
      "any_of": []
    }
  },
  "outputs": {
    "4d_cams": {
      "tags": [
        "colmap4d-cams"
      ],
      "storage": "dir",
      "description": null,
      "preview": null,
      "arrayed": false,
      "scalar": false,
      "tags_from": null,
      "dim_labels": [],
