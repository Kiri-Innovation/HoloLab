    "reconstruction",
    "colmap4d"
  ],
  "docs": "Input is one timeless colmap-camera JSON (model, width, height, params, qvec wxyz, tvec; world-to-camera). Output is a colmap4d-cams component. Frame count is floor(duration * fps), from 1 to 1000000. Times are start_time_ns + round(i * 1e9 / fps), nearest ties-to-even. No pixels or point observations are generated. Time is explicitly synthetic.",
  "source_entry": "repeat_4d.py",
  "arrayable": false,
  "parallelism": null,
  "batch_size": null,
  "type_capabilities": {},
