            ]
          }
        },
        "params": {
          "strict_validate": {
            "default": false,
            "description": "Default false: validate binary structure, full ID/time coverage, geometry, pixels and track bounds with arrays. Single-observation points receive exhaustive reciprocal/time checks; multi-observation relations and centroids are sampled. Enable for untrusted/external data to run full legacy reciprocal checks and final validate_full(strict). Text/nonuniform layouts automatically use full validation.",
